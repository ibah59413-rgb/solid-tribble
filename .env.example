PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/banna_ai_db
# Use true only when your hosted PostgreSQL provider requires TLS.
DATABASE_SSL=false
DATABASE_POOL_SIZE=10
# Replace with a random secret of at least 32 characters. Keep this private.
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Set your provider API key on the server only. Never put it in a mobile/web client.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional comma-separated exact origins, e.g. http://localhost:8081,https://your-app.example
CORS_ORIGINS=
